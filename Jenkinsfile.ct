groovy
pipeline {
    agent any

    triggers {
        cron('H/30 * * * *')
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        MLFLOW_TRACKING_URI = 'http://host.docker.internal:5001'
        PYTHONUNBUFFERED = '1'
    }

    stages {
        stage('Show CT Trigger') {
            steps {
                echo '========================================'
                echo '     CONTINUOUS TRAINING MONITOR'
                echo '========================================'
                echo 'Checking production drift...'
            }
        }

        stage('Environment Check') {
            steps {
                sh '''
                    python3 --version
                    pwd
                '''
            }
        }

        stage('Prepare Monitoring Artifacts') {
            steps {
                sh '''
                    mkdir -p artifacts

                    cp /shared-artifacts/drift_report.csv \
                       artifacts/drift_report.csv

                    if [ -f /shared-artifacts/last_ct_drift_hash.txt ]; then
                        cp /shared-artifacts/last_ct_drift_hash.txt \
                           artifacts/last_ct_drift_hash.txt
                    fi

                    echo "Monitoring artifacts prepared."

                    ls -l artifacts/
                '''
            }
        }

        stage('Check Drift and Trigger CT') {
            steps {
                sh '''
                    python3 -m src.monitoring.ct_trigger
                '''
            }
        }

        stage('Persist CT State') {
            steps {
                sh '''
                    if [ -f artifacts/last_ct_drift_hash.txt ]; then
                        cp artifacts/last_ct_drift_hash.txt \
                           /shared-artifacts/last_ct_drift_hash.txt

                        echo "CT drift state persisted."
                    else
                        echo "No CT state file created."
                    fi
                '''
            }
        }
    }

    post {
        success {
            echo '========================================'
            echo 'CT monitoring check completed successfully.'
            echo '========================================'
        }

        failure {
            echo '========================================'
            echo 'CT monitoring check failed.'
            echo 'Check Jenkins Console Output.'
            echo '========================================'
        }

        always {
            archiveArtifacts(
                artifacts: 'artifacts/drift_report.csv,artifacts/last_ct_drift_hash.txt',
                allowEmptyArchive: true
            )
        }
    }
}
